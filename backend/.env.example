# Copy this file to .env and fill in values from the Supabase project settings.
# Never commit .env. Never put these values in the Vite frontend except the
# publishable/anon key + URL if the browser talks to Supabase Auth directly.

# Project URL, e.g. https://xxxxxxxx.supabase.co (no trailing slash)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...) or legacy anon key (eyJ...).
# Used as the Kong/API gateway `apikey` header. Not a substitute for the user JWT.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Legacy JWT secret (HS256) from Project Settings → API.
# Required only if Auth JWTs are still signed with HS256.
# Leave empty when the project uses asymmetric JWT signing keys (ES256/RS256 + JWKS).
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Must match the JWT `aud` claim. Supabase user access tokens use "authenticated".
JWT_AUDIENCE=authenticated

# Override only if your tokens use a non-default issuer.
# Default is {SUPABASE_URL}/auth/v1
JWT_ISSUER=

# Comma-separated algorithms this API will accept after cryptographic verification.
JWT_ALGORITHMS=ES256,RS256,HS256

# Optional AI provider settings. Never place the API key in Vite variables.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_SECONDS=20
